{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jdosqolydtmspejyyjvm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "super-helper-mcp",
      "version": "0.1.0",
      "title": "Super-Helper"
    },
    "tools": [
      {
        "name": "list_groups",
        "title": "List your groups",
        "description": "List all shopping groups the signed-in user belongs to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_items",
        "title": "List shopping items",
        "description": "List items in a group. Filter by status: pending (default), purchased, or all.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "format": "uuid",
              "description": "Group ID."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "purchased",
                "all"
              ],
              "description": "Filter items by status. Default: pending."
            }
          },
          "required": [
            "group_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_messages",
        "title": "List reminders/messages",
        "description": "List recent reminder messages in a group (newest first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "format": "uuid"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "group_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_members",
        "title": "List group members",
        "description": "List members of a group.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "group_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_item",
        "title": "Add shopping item",
        "description": "Add a new item to a group's shopping list.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "is_private": {
              "type": "boolean"
            }
          },
          "required": [
            "group_id",
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "mark_item_purchased",
        "title": "Mark item purchased",
        "description": "Mark a shopping item as purchased.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "item_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_item",
        "title": "Delete item",
        "description": "Delete a shopping item from the list.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "item_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_message",
        "title": "Send a reminder",
        "description": "Post a reminder message to a group. Delivers a push notification to other group members.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string",
              "format": "uuid"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "group_id",
            "body"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
